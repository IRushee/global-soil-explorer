            "example": "ph_water"
          },
          "value": {
            "type": "number",
            "title": "Value",
            "description": "The numeric measurement value.",
            "example": 6.5
          },
          "unit": {
            "$ref": "#/components/schemas/Unit",
            "description": "Standardized unit of measurement.",
            "example": "ph"
          }
        },
        "type": "object",
        "required": [
          "property_type",
          "value",
          "unit"
        ],
        "title": "SoilPropertySchema",
        "description": "Legacy property model (retained for backward compatibility)."
      },
      "SoilTextureSchema": {
        "properties": {
          "usda_texture": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usda Texture",
            "description": "Soil texture class identifier based on USDA standard.",
            "example": 3
          },
          "soter_texture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
