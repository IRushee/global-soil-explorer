            "example": 80.0
          },
          "hydrologic_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HydrologicContextSchema"
              },
              {
                "type": "null"
              }
            ],
            "description": "Hydrologic attributes of this profile."
          },
          "land_limitations": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LandLimitationsSchema"
              },
              {
                "type": "null"
              }
            ],
            "description": "Agronomic and growth limitation ratings."
          },
          "sequence_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sequence Index",
            "description": "Rank of this profile in the overall mapping unit.",
            "example": 1
          }
        },
        "type": "object",
        "required": [
          "layers",
          "classification"
        ],
        "title": "SoilProfileSchema",
        "description": "Multi-layer vertical soil profile schema."
      },
      "SoilPropertySchema": {
        "properties": {
          "property_type": {
            "$ref": "#/components/schemas/PropertyType",
