          },
          "classification": {
            "$ref": "#/components/schemas/SoilClassificationSchema",
            "description": "Taxonomic classification details."
          },
          "composition_share": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
