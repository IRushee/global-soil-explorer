{
  "openapi": "3.1.0",
  "info": {
    "title": "Global Soil Explorer API",
    "description": "REST API exposing Harmonized World Soil Database (HWSD) v2.0 dataset spatial lookup and database queries.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Check Application Health",
        "description": "Returns current health status and versions for python runtime, spatial lookup grid parser, and SQLite database connectivity.",
        "operationId": "check_health_health_get",
        "responses": {
          "200": {
            "description": "All infrastructure components are fully operational.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseSchema"
                }
              }
            }
          },
          "503": {
            "description": "One or more infrastructure components are unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/soil": {
      "get": {
        "summary": "Query Soil Observation",
        "description": "Retrieves vertical soil profile properties, texture shares, and taxonomic classifications at the specified latitude and longitude coordinates.",
        "operationId": "get_soil_soil_get",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Geographic latitude coordinate in decimal degrees (-90 to 90).",
              "example": 52.0,
              "title": "Latitude"
            },
            "description": "Geographic latitude coordinate in decimal degrees (-90 to 90)."
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Geographic longitude coordinate in decimal degrees (-180 to 180).",
              "example": 10.0,
              "title": "Longitude"
            },
            "description": "Geographic longitude coordinate in decimal degrees (-180 to 180)."
          }
        ],
        "responses": {
          "200": {
            "description": "Coordinates resolved and observation returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoilObservationSchema"
                }
              }
            }
          },
          "204": {
            "description": "Coordinates resolved to a void/ocean area (no observation)."
          },
          "400": {
            "description": "Geographic coordinates are invalid or out of bounds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "503": {
            "description": "Underlying spatial index or database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected application failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
